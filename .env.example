# Frontend environment flags (Vite). Copy to .env / .env.local to enable.

# WebSocket base URL (optional; defaults to http://localhost:3001)
# VITE_WS_URL=http://localhost:3001

# Experimental PageDocument PDF export button (Phase 7AA).
# When "true", an extra secondary "🧪 تصدير PDF تجريبي" button appears on the
# Reports page next to the official export buttons. It calls the experimental
# backend endpoint POST /reports/experimental/page-document/pdf with { campaignId }.
# The official PDF/Word export buttons are unchanged regardless of this flag.
# Requires the backend flag EXPERIMENTAL_PAGE_DOCUMENT_PDF=true as well.
# VITE_EXPERIMENTAL_PAGE_DOCUMENT_PDF=true
VITE_EXPERIMENTAL_PAGE_DOCUMENT_PDF=true